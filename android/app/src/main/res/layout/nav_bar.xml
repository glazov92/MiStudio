<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_bar"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@color/bg"
    android:clipChildren="false"
    android:elevation="10dp"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/tab_home"
        style="@style/NavTab">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/tab_home"
            android:src="@drawable/ic_nav_home"
            app:tint="@color/nav_item" />

        <TextView
            style="@style/NavTabLabel"
            android:text="@string/tab_home" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tab_services"
        style="@style/NavTab">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/tab_services"
            android:src="@drawable/ic_nav_services"
            app:tint="@color/nav_item" />

        <TextView
            style="@style/NavTabLabel"
            android:text="@string/tab_services" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/call_slot"
        android:layout_width="76dp"
        android:layout_height="match_parent"
        android:clipChildren="false">

        <ru.studiomi.app.PulseView
            android:id="@+id/pulse"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="center" />

        <ImageButton
            android:id="@+id/btn_call"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_call_circle"
            android:contentDescription="@string/call"
            android:elevation="4dp"
            android:padding="15dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_call_white" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/tab_works"
        style="@style/NavTab">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/tab_works"
            android:src="@drawable/ic_nav_works"
            app:tint="@color/nav_item" />

        <TextView
            style="@style/NavTabLabel"
            android:text="@string/tab_works" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tab_contacts"
        style="@style/NavTab">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/tab_contacts"
            android:src="@drawable/ic_nav_contacts"
            app:tint="@color/nav_item" />

        <TextView
            style="@style/NavTabLabel"
            android:text="@string/tab_contacts" />
    </LinearLayout>
</LinearLayout>
